HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://localhost:3100
DATA_DIR=./data
OPENAI_BASE_URL=https://api.ranvik.ru/v1
OPENAI_API_KEY=
# Confirm this exact model ID is available for your API key. No silent fallback.
OPENAI_MODEL=gpt-6-luna
# Required: your actual Ranvik prices expressed as USD per million tokens.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Fixed accounting conversion; divide RUB token prices by this value above.
# Never change after recording usage without migrating stored amounts/limits.
DISPLAY_CURRENCY=RUB
ACCOUNTING_RUB_PER_USD=84.4283
COMPANY_TIMEZONE=Europe/Moscow
TRUST_PROXY_LOOPBACK=false
MAX_CONCURRENT_REQUESTS=20
