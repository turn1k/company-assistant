[Unit]
Description=Company Assistant verified account and configuration backup
After=company-assistant.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/company-assistant-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# SQLite read-only connections may need to create/rebuild WAL shared memory.
# The script opens the source database with mode=ro and never modifies rows.
ReadWritePaths=/var/backups/company-assistant /var/lib/company-assistant
TimeoutStartSec=300

