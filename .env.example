HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://localhost:3100
DATA_DIR=./data
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
COMPANY_TIMEZONE=Europe/Moscow
# Set to true ONLY behind the supplied local Caddy reverse proxy.
TRUST_PROXY_LOOPBACK=false
# Optional local MaxMind GeoLite2 City database. No external location service is used.
GEOIP_DATABASE=
# Upper-bound USD prices per million tokens. Keep aligned with the selected model.
INPUT_USD_PER_MILLION=0.30
OUTPUT_USD_PER_MILLION=1.20
MAX_CONCURRENT_REQUESTS=20
