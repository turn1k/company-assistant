HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://localhost:3100
DATA_DIR=./data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
COMPANY_TIMEZONE=Europe/Moscow
# Set to true ONLY behind the supplied local Caddy reverse proxy.
TRUST_PROXY_LOOPBACK=false
# Optional local MaxMind GeoLite2 City database. No external location service is used.
GEOIP_DATABASE=
# Upper-bound USD prices per million tokens. Keep aligned with the selected model.
INPUT_USD_PER_MILLION=0.10
OUTPUT_USD_PER_MILLION=0.50
MAX_CONCURRENT_REQUESTS=20

# Ranvik: set OPENAI_BASE_URL=https://api.ranvik.ru/v1 and put its key in OPENAI_API_KEY.
# Keep gpt-6-luna only if this exact ID is available for your Ranvik key.
# Set both USD-equivalent tariffs above to your actual provider rates (not OpenAI rates).
OPENAI_BASE_URL=https://api.openai.com/v1
